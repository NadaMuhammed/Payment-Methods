<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- Headings -->
    <style name="Text.Display">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="Text.Headline">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="Text.Title">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <style name="Text.Subtitle">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <!-- Body -->
    <style name="Text.Body" />

    <style name="Text.Body.Medium">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="Text.Body.Bold">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="Text.Body.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Body.Large">
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <!-- Small text -->
    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Caption.Error">
        <item name="android:textColor">@color/color_error</item>
    </style>

    <style name="Text.Overline">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/text_overline</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Labels for buttons and inputs -->
    <style name="Text.Label">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.Label.OnPrimary">
        <item name="android:textColor">@color/text_on_primary</item>
    </style>
</resources>
